# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Postgres credentials — used by BOTH the postgres container and the bot
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot
POSTGRES_DB=rescued_people

# Host port the postgres container is published on (host -> container 5432).
# 5433 by default so it does not clash with a Postgres already running locally.
POSTGRES_PORT_EXPOSED=5433

# The two vars below are ONLY for running the app outside Docker (npm run start:dev).
# Inside docker compose the bot gets POSTGRES_HOST=postgres / POSTGRES_PORT=5432
# from docker-compose.yml, and this .env file is never injected into the containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

DB_SYNCHRONIZE=true
DB_LOGGING=false

# App
PORT=3000
BOT_PORT=3000
TZ=UTC

# NDRRMA source
NDRRMA_API_URL=https://ndrrma.gov.np/api/v1/rescues/rescued-persons/
NDRRMA_NATIONALITY=foreign
NDRRMA_PAGE_SIZE=100
NDRRMA_TIMEOUT_MS=20000
RASUWA_PAGE_URL=https://ndrrma.gov.np/en/rasuwa

# Limits
MIN_SURNAME_LENGTH=2
MAX_SURNAMES_PER_USER=25
MAX_MESSAGES_PER_USER_PER_RUN=20
PERSONS_CACHE_TTL_MS=60000
